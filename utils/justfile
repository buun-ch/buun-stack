set dotenv-filename := ".env.local"

export PROMETHEUS_NAMESPACE := env("PROMETHEUS_NAMESPACE", "monitoring")

[private]
default:
    @just --list --unsorted --list-submodules

# Generate a random password
random-password length='48':
    @LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | fold -w {{length}} | head -n 1

# Check that telepresence is connected (for recipes that use in-cluster DNS)
check-telepresence:
    #!/bin/bash
    set -euo pipefail
    if ! command -v telepresence &>/dev/null; then
        echo "Error: telepresence is not installed" >&2
        exit 1
    fi
    # `telepresence status` exits 0 even when disconnected, so check the output
    if ! telepresence status 2>/dev/null | grep -qi "Traffic Manager: Connected"; then
        echo "Error: telepresence is not connected" >&2
        echo "This recipe reaches an in-cluster service via *.svc.cluster.local." >&2
        echo "Please run: telepresence connect" >&2
        exit 1
    fi

# Check that Prometheus Operator is available when monitoring is requested
check-monitoring enabled='':
    #!/bin/bash
    set -euo pipefail
    ENABLED="{{ enabled }}"
    if [ -z "${ENABLED}" ]; then
        exit 0
    fi
    if [ "${ENABLED}" != "true" ]; then
        echo "Error: MONITORING_ENABLED must be 'true' or empty (got '${ENABLED}')." >&2
        echo "Any non-empty value enables monitoring in the Helm values templates." >&2
        echo "Set MONITORING_ENABLED= (empty) in .env.local to disable monitoring." >&2
        exit 1
    fi
    if helm status kube-prometheus-stack -n ${PROMETHEUS_NAMESPACE} &>/dev/null; then
        exit 0
    fi
    echo "Error: MONITORING_ENABLED is 'true' but kube-prometheus-stack is not" >&2
    echo "installed in the '${PROMETHEUS_NAMESPACE}' namespace." >&2
    echo "The ServiceMonitor CRD (monitoring.coreos.com/v1) is required." >&2
    echo "" >&2
    echo "Either install it:" >&2
    echo "  just prometheus::install" >&2
    echo "or disable monitoring by setting MONITORING_ENABLED= (empty) in .env.local" >&2
    exit 1

# Check if connection to host and port is possible
check-connection host='' port='':
    #!/bin/bash
    set -euo pipefail
    HOST="{{host}}"
    while [ -z "${HOST}" ]; do
        HOST=$(gum input --prompt="Host: " --width=80)
    done
    PORT="{{port}}"
    while [ -z "${PORT}" ]; do
        PORT=$(gum input --prompt="Port: " --width=80)
    done
    if ! nc -z -w 1 ${HOST} ${PORT} &>/dev/null; then
        echo "Connection to ${HOST}:${PORT} failed"
        echo "Execute \`telepresence connect\` if it is in a Kubernetes cluster"
        exit 1
    fi
